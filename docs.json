{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "Meridian",
  "description": "Step-by-step guides, product updates, and more for Meridian.",
  "colors": {
    "primary": "#141414",
    "light": "#e9e9e9",
    "dark": "#111111"
  },
  "favicon": {
    "light": "/images/mrdnlogodark2.svg",
    "dark": "/images/mrdnlogolight2.svg"
  },
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "latex": true
  },
  "contextual": {
    "options": [
      "copy",
      "chatgpt",
      "claude",
      "aistudio",
      "cursor",
      "download-spec"
    ],
    "display": "toc"
  },
  "navigation": {
    "directory": "card",
    "products": [
      {
        "product": "Meridian",
        "color": {
          "light": "#8f82ec",
          "dark": "#8f82ec"
        },
        "groups": [
          {
            "group": "Information",
            "expanded": true,
            "pages": [
              "welcome",
              "faq",
              "acknowledgements"
            ]
          },
          {
            "group": "Builder",
            "expanded": true,
            "pages": [
              {
                "group": "Messages",
                "icon": "messages-square",
                "expanded": true,
                "pages": [
                  "builder/messages/send-a-message",
                  "builder/messages/send-a-form"
                ]
              },
              {
                "group": "API & Third Party",
                "icon": "radio",
                "expanded": true,
                "pages": [
                  "builder/api/api",
                  "builder/api/ask-ai"
                ]
              },
              {
                "group": "Loops",
                "icon": "repeat",
                "expanded": true,
                "pages": []
              },
              {
                "group": "Logic",
                "icon": "move-horizontal",
                "expanded": true,
                "pages": []
              },
              {
                "group": "Roles",
                "icon": "shield-user",
                "expanded": true,
                "pages": []
              },
              {
                "group": "Channels",
                "icon": "hash",
                "expanded": true,
                "pages": []
              },
              {
                "group": "Voice",
                "icon": "audio-lines",
                "expanded": true,
                "pages": []
              },
              {
                "group": "Variables & Data storage",
                "icon": "database",
                "expanded": true,
                "pages": []
              },
              {
                "group": "Users",
                "icon": "users",
                "expanded": true,
                "pages": []
              },
              {
                "group": "Functions",
                "icon": "diamond",
                "expanded": true,
                "pages": []
              },
              {
                "group": "Builder settings",
                "icon": "settings-2",
                "expanded": true,
                "pages": []
              },
              {
                "group": "Other",
                "icon": "menu",
                "expanded": true,
                "pages": []
              }
            ]
          },
          {
            "group": "Dashboard",
            "expanded": true,
            "pages": [
              "dashboard/home",
              "dashboard/marketplace",
              "dashboard/storage",
              "dashboard/status",
              "dashboard/logs"
            ]
          },
          {
            "group": "Welcome to Meridian",
            "expanded": true,
            "pages": [
              "welcome/onboarding",
              "welcome/create-a-bot"
            ]
          },
          {
            "group": "Explainers",
            "expanded": true,
            "pages": [
              "explainer/power-usage"
            ]
          },
          {
            "group": "short links",
            "hidden": true,
            "pages": [
              "ummm",
              "discord"
            ]
          }
        ]
      },
      {
        "product": "Citrum",
        "color": {
          "light": "#f2cc4d",
          "dark": "#f2cc4d"
        },
        "versions": [
          {
            "version": "Users",
            "default": true,
            "pages": [
              "citrum/welcome"
            ]
          },
          {
            "version": "Developers"
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/images/documentationwordmarkblack.png",
    "dark": "/images/documentationwordmarkwhite.png",
    "href": "https://meridian.surf"
  },
  "navbar": {
    "links": [
      {
        "href": "https://meridian.surf/determine",
        "label": "meridian.surf"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://dashboard.meridian.surf/home"
    }
  },
  "footer": {
    "socials": {
      "discord": "https://l.meridian.surf/discord",
      "website": "https://meridian.surf"
    },
    "links": [
      {
        "header": "Meridian",
        "items": [
          {
            "label": "Homepage",
            "href": "https://meridian.surf"
          },
          {
            "label": "Dashboard",
            "href": "https://dashboard.meridian.surf/home"
          }
        ]
      },
      {
        "header": "Support",
        "items": [
          {
            "label": "Discord server",
            "href": "/discord"
          },
          {
            "label": "Help center",
            "href": "https://help.meridian.surf"
          },
          {
            "label": "Email us",
            "href": "mailto:care@meridian.surf"
          }
        ]
      },
      {
        "header": "Policies",
        "items": [
          {
            "label": "All policies",
            "href": "https://meridian.surf/legal"
          },
          {
            "label": "Terms of Service",
            "href": "https://meridian.surf/legal/terms"
          },
          {
            "label": "Privacy Policy",
            "href": "https://meridian.surf/legal/privacy"
          }
        ]
      }
    ]
  },
  "search": {
    "prompt": "Search..."
  },
  "markdown": {
    "schema": true
  },
  "errors": {
    "404": {
      "redirect": false,
      "title": "Whoops, not found..."
    }
  },
  "api": {
    "examples": {
      "prefill": true,
      "autogenerate": false
    },
    "url": "full"
  },
  "background": {
    "color": {
      "light": "#e0e0e0",
      "dark": "#0e0e0e"
    }
  },
  "thumbnails": {
    "fonts": {
      "family": "Geist"
    }
  },
  "metadata": {
    "timestamp": true
  },
  "interaction": {
    "drilldown": false
  },
  "seo": {
    "indexing": "all"
  }
}
