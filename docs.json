{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "Meridian",
  "description": "Step-by-step guides, product updates, and more for Meridian.",
  "colors": {
    "primary": "#5369f5",
    "light": "#7d8eff",
    "dark": "#4A55D2"
  },
  "favicon": {
    "light": "/images/Meridianlogowhite.svg",
    "dark": "/images/Meridianlogodark.svg"
  },
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "aistudio",
      "claude",
      "chatgpt"
    ]
  },
  "navigation": {
    "directory": "card",
    "pages": [
      "welcome",
      "help",
      "discord"
    ]
  },
  "logo": {
    "light": "/images/Meridianlogodark.svg",
    "dark": "/images/Meridianlogowhite.svg",
    "href": "https://meridian.surf"
  },
  "navbar": {
    "links": [
      {
        "href": "https://meridian.surf/dashboard",
        "label": "Dashboard"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://dashboard.mintlify.com"
    }
  },
  "footer": {
    "socials": {
      "discord": "https://discord.gg/6BEun7GpUt",
      "github": "https://github.com/Robskan/meridian-docs"
    },
    "links": [
      {
        "header": "Meridian",
        "items": [
          {
            "label": "Homepage",
            "href": "https://meridian.surf"
          },
          {
            "label": "Dashboard",
            "href": "https://meridian.surf/dashboard"
          }
        ]
      },
      {
        "header": "Support",
        "items": [
          {
            "label": "Discord server",
            "href": "https://discord.gg/6BEun7GpUt"
          },
          {
            "label": "Help center",
            "href": "https://meridian.surf/help"
          },
          {
            "label": "Email us",
            "href": "mailto:care@meridian.surf"
          }
        ]
      },
      {
        "header": "Legal",
        "items": [
          {
            "label": "Legal center",
            "href": "https://meridian.surf/legal"
          },
          {
            "label": "Terms of Service",
            "href": "https://meridian.surf/legal/terms"
          },
          {
            "label": "Privacy Policy",
            "href": "https://meridian.surf/legal/privacy"
          }
        ]
      }
    ]
  },
  "banner": {
    "content": "Meridian is currently in alpha, so things can and will change, so information provided on this documentation might not be up-to-date.",
    "dismissible": true
  },
  "search": {
    "prompt": "Search..."
  },
  "markdown": {
    "schema": true
  },
  "fonts": {
    "family": "Geist"
  },
  "errors": {
    "404": {
      "redirect": true
    }
  },
  "variables": {
    "phase": "Alpha"
  }
}
